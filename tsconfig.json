{
  "compilerOptions": {
    "lib": ["ES2022", "ES2022.Intl"],
    "module": "CommonJS",
    "target": "ES2022",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "raycast-env.d.ts"]
}
